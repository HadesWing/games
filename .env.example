# 语义向量引擎配置（复制为 .env 后按需修改；.env 不进版本库）

# ollama = 本地模型（推荐，零成本、无网络依赖）
# openai = 任意 OpenAI 兼容的 /v1/embeddings 服务（硅基流动、阿里百炼、LM Studio 等）
# off    = 关闭向量，只用人工语义图谱
EMBED_PROVIDER=ollama

# 本地 ollama 默认 http://127.0.0.1:11434
EMBED_BASE_URL=http://127.0.0.1:11434

# 中文词相似度推荐 bge-m3；轻量替代：quentinz/bge-small-zh-v1.5
EMBED_MODEL=bge-m3

# 只有云端 provider 才需要
EMBED_API_KEY=sk-xxxx

# 单次请求超时（毫秒）
EMBED_TIMEOUT_MS=8000
